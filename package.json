{
  "name": "team-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "test:unit": "vitest run functions/src",
    "deploy:functions": "firebase deploy --only functions",
    "test:rules":"firebase emulators:exec --only firestore --project demo-team-chat \"vitest run\"",
    "rules:check": "firebase deploy --only firestore:rules --dry-run",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
